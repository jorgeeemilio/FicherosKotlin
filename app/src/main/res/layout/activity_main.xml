<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nuevo_fondo"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Top Bar: File Name input and Action Buttons -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/edtNombreFichero"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edittext_transparent"
            android:hint="@string/hint_nombre_fichero"
            android:inputType="text"
            android:padding="12dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textColorHint="@color/white_hint"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/transparent_yellow_btn"
            android:text="@string/btn_guardar"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/white_stroke"
            app:strokeWidth="1.5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAbrir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/transparent_green_btn"
            android:text="@string/btn_abrir"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/white_stroke"
            app:strokeWidth="1.5dp" />
    </LinearLayout>

    <!-- Content Area: Large Multiline Text Editor -->
    <EditText
        android:id="@+id/edtContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_edittext_transparent"
        android:gravity="top|start"
        android:hint="@string/hint_contenido"
        android:inputType="textMultiLine"
        android:overScrollMode="always"
        android:padding="16dp"
        android:scrollbars="vertical"
        android:textColor="@color/white"
        android:textColorHint="@color/white_hint"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/btnBorrar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar" />

    <!-- Bottom Action: Clear Content Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBorrar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/transparent_red_btn"
        android:text="@string/btn_borrar"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/white_stroke"
        app:strokeWidth="1.5dp" />

</androidx.constraintlayout.widget.ConstraintLayout>